# ===== 应用 =====
APP_NAME=AI Video Studio
DEBUG=false

# 安全密钥（务必替换）
SECRET_KEY=change-me-to-a-long-random-string
# 用于加密存储用户 API Key 的 Fernet 密钥（44 位 base64）
ENCRYPTION_KEY=change-me-fern-kbM8mQ0mF8d2jW4v1sC6pZ9xR3tY7uN0aB5cD8eF=

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:7788,http://127.0.0.1:7788

# ===== 基础设施 =====
DATABASE_URL=postgresql+asyncpg://aivideo:aivideo@postgres:5432/aivideo
REDIS_URL=redis://redis:6379/0

# 媒体文件存储目录（容器内路径）
MEDIA_ROOT=/data/media
# 媒体对外访问前缀
MEDIA_URL_PREFIX=/media

# 允许上传的最大文件（MB）
MAX_UPLOAD_MB=512

# 单次生成任务的超时（秒）
GENERATION_TIMEOUT=900

# 注册邀请码：留空允许自由注册；设置后注册必须填写相同邀请码
REGISTRATION_INVITE_CODE=

# 允许厂商 base_url 指向本机/内网（本地 Ollama 等场景才开启，默认关闭防 SSRF）
ALLOW_PRIVATE_OUTBOUND=false

# 厂商拉取参考图用的媒体签名有效期（秒）
MEDIA_SIGNATURE_TTL_SECONDS=86400
